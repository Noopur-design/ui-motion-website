# Contact form endpoint (copy this file to .env.local and fill it in).
# Any service that accepts a JSON POST and returns a 2xx on success works,
# e.g. Formspree (https://formspree.io/f/xxxxxxx), Basin, Getform, or your own API.
# When left empty, the form falls back to opening the visitor's email app.
VITE_FORM_ENDPOINT=
